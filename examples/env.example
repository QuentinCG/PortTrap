TCP_PORTS="20,21,22,23,445,1433,3306,3389,5432,5900,6379,8080,27017"
UDP_PORTS="161,5060"
# LOG_STDOUT: when true, events are written to stdout as well as to file (if LOG_FILE set).
# Set to false to write only to file.
LOG_STDOUT=true

# LOG_FILE: path to the file where PortTrap will write logs.
# If empty, PortTrap only writes to stdout. For system-wide logging on Linux,
# set this to /var/log/porttrap/porttrap.log and ensure the directory exists and
# is writable by the user running the binary:
#
#   sudo mkdir -p /var/log/porttrap
#   sudo chown $(whoami):$(whoami) /var/log/porttrap
#   sudo chmod 0755 /var/log/porttrap
#
# Example (recommended for production):
LOG_FILE=/var/log/porttrap/porttrap.log

# LOG_FORMAT = 'text' or 'json'
LOG_FORMAT=text
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=5
MAX_CONNECTIONS=1024
